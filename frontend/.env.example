# Dev auth (default when Cognito user pool ID is unset) — matches backend appsettings.Development
VITE_USE_DEV_AUTH=true
VITE_DEV_SIGNING_KEY=quote-depot-dev-signing-key-min-32-chars!

# Cognito embedded sign-in (production / staging)
# VITE_USE_DEV_AUTH=false
# VITE_COGNITO_REGION=us-east-1
# VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
