# Cognito (production / staging) — create pool manually; see deploy/README.md
ASPNETCORE_ENVIRONMENT=Production
Cognito__Region=us-east-1
Cognito__UserPoolId=us-east-1_XXXXXXXXX
Cognito__ClientId=xxxxxxxxxxxxxxxxxxxxxxxxxx
Cognito__Domain=your-cognito-domain-prefix
Cognito__RedirectUri=https://your.domain/signin/callback
Cognito__UseDevAuth=false

# Local SQLite + uploads (Compose overrides paths to /data inside the API container)
Data__SqlitePath=data/quotedepot.db
Data__UploadsPath=data/uploads

# Host port published by the web/Nginx container
HOST_HTTP_PORT=8080
